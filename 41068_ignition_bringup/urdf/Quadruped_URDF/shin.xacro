<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find 41068_ignition_bringup)/urdf/Quadruped_URDF/shin.gazebo"/>
  
  <xacro:macro name="shin_v0" params="prefix parent *joint_origin *joint_axis">
	<joint name="${prefix}_shin_joint" type="revolute">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="${prefix}_shin_link"/>
          <limit effort="500" velocity="10" lower="-3.14159" upper = "3.14159"/>
          <dynamics damping="0.005" friction="0.1"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="${prefix}_shin_link">
	  <visual>
		<geometry>
		  <mesh filename="file://$(find 41068_ignition_bringup)/urdf/meshes/Quadruped/shin.dae"/>
		</geometry>
	  </visual>
	  <collision>
		<geometry>
		  <mesh filename="file://$(find 41068_ignition_bringup)/urdf/meshes/Quadruped/shin.stl"/>
		</geometry>
	  </collision>
	  <inertial>
		<origin xyz="-0.158 0.011 0.0"/>
		<mass value="0.66"/>
		<inertia ixx="0.0003" ixy="0.0013" ixz="0.000045" iyy="0.029" iyz="-0.000003" izz="0.029" />
	  </inertial>
	</link>
  </xacro:macro>
  
</robot>
