<sdf version="1.7">
<model name="grass_plane">
    <static>true</static>
    <link name="link">
        <!--<collision name="collision">
            <geometry>
            <plane>
                <normal>0 0 1</normal>
                <size>50 50</size>
            </plane>
            </geometry>
        </collision>-->
        <collision name="collision">
            <geometry>
            <box>
                <normal>0 0 1</normal>
                <size>50 50 0.01</size>
            </box>
            </geometry>
        </collision>
        <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry>
            <plane>
                <normal>0 0 1</normal>
                <size>50 50</size>
            </plane>
            </geometry>
            <material>
                <!-- <diffuse>0.8 0.8 0.8 1</diffuse> -->
                <ambient>1.0 1.0 1.0 1</ambient>
                <diffuse>1.0 1.0 1.0 1</diffuse>
                <!--<specular>1.0 1.0 1.0 1</specular>-->
                <pbr>
                    <metal>
                    <albedo_map>
                        model://forest_plane/materials/textures/forest_overhead.png
                    </albedo_map>
                    </metal>
                </pbr>
            </material>
        <plugin filename="ignition-gazebo-thermal-system"
                name="ignition::gazebo::systems::Thermal">
          <temperature>300.15</temperature>
          <emissivity>0.95</emissivity>
        </plugin>
        </visual>
    </link>
</model>
</sdf>
