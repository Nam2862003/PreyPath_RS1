      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://deer/meshes/deer.obj</uri>
          </mesh>
        </geometry>
        <plugin filename="ignition-gazebo-thermal-system"
                name="ignition::gazebo::systems::Thermal">
          <temperature>313.15</temperature>
          <emissivity>0.95</emissivity>
        </plugin>
      </visual>


      <collision name="collision">
        <geometry>
          <mesh><uri>model://deer/meshes/deer.stl</uri></mesh>
        </geometry>
      </collision>
    </link>
  </model>
